{
    "openapi": "3.0.0",
    "info": {
        "title": "Emra Backend API",
        "description": "API Documentation for Emra Backend",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://emra.pixelmindeg.com",
            "description": "Production Server"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register",
                "description": "Create a new user account",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "phone",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Yosra"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Khattab"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "01000000000"
                                    },
                                    "second_phone": {
                                        "type": "string",
                                        "example": "01100000000",
                                        "nullable": true
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "Mansoura",
                                        "nullable": true
                                    },
                                    "governorate": {
                                        "type": "string",
                                        "example": "Dakahlia",
                                        "nullable": true
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "yosra@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registered successfully"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login",
                "description": "Login user and return access token",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "yosra@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/forgot-password": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Forgot Password",
                "description": "Send password reset link to user's email",
                "operationId": "20d78161b19ac6afb56924e74974ec46",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "yosra@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset link sent successfully"
                    },
                    "422": {
                        "description": "User not found"
                    }
                }
            }
        },
        "/api/reset-password": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Reset Password",
                "description": "Reset user password using reset token",
                "operationId": "0a6624b616e4ba5a310a61d9f7418c35",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "token"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "yosra@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "12345678"
                                    },
                                    "token": {
                                        "type": "string",
                                        "example": "reset_token_here"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successfully"
                    },
                    "422": {
                        "description": "Reset failed"
                    }
                }
            }
        },
        "/api/profile": {
            "get": {
                "tags": [
                    "Profile"
                ],
                "summary": "Show Profile",
                "description": "Get the authenticated user profile",
                "operationId": "94a5f4c5f5e5755cf43698cf9bc49e9d",
                "responses": {
                    "200": {
                        "description": "Profile retrieved successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Profile"
                ],
                "summary": "Update Profile",
                "description": "Update the authenticated user profile",
                "operationId": "4ac9a00014f69a885c9373fdefcaf6f9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Yosra"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Khattab"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "01000000000"
                                    },
                                    "second_phone": {
                                        "type": "string",
                                        "example": "01100000000",
                                        "nullable": true
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "Mansoura",
                                        "nullable": true
                                    },
                                    "governorate": {
                                        "type": "string",
                                        "example": "Dakahlia",
                                        "nullable": true
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "yosra@gmail.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile updated successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout",
                "description": "Logout authenticated user",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logged out successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/cart": {
            "get": {
                "tags": [
                    "Cart"
                ],
                "summary": "Get Cart",
                "description": "Retrieve the cart of the authenticated user, or of a guest identified by the Guest-Token header. Returns an empty cart when none exists yet.",
                "operationId": "f5a6af9d859f5af3146dd7e0f33f80c2",
                "parameters": [
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cart retrieved successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    }
                }
            },
            "post": {
                "tags": [
                    "Cart"
                ],
                "summary": "Add To Cart",
                "description": "Add a product variant to the cart. When the variant is already in the cart its quantity is increased instead of adding a second line. The cart is created on the fly if it does not exist.",
                "operationId": "3283d17024a75328763e21978d85cf48",
                "parameters": [
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "product_variant_id"
                                ],
                                "properties": {
                                    "product_variant_id": {
                                        "description": "Product variant ID",
                                        "type": "integer"
                                    },
                                    "quantity": {
                                        "description": "Quantity to add, defaults to 1",
                                        "type": "integer",
                                        "default": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Product added to cart successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    },
                    "422": {
                        "description": "Validation error or not enough stock"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Cart"
                ],
                "summary": "Clear Cart",
                "description": "Remove every item from the cart of the authenticated user, or of the guest identified by the Guest-Token header.",
                "operationId": "a3e8164a5241227f621eac34aaba1a0f",
                "parameters": [
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cart cleared successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    }
                }
            }
        },
        "/api/cart/{itemId}": {
            "put": {
                "tags": [
                    "Cart"
                ],
                "summary": "Update Cart Item",
                "description": "Set the quantity of a cart item. The item must belong to the cart of the authenticated user or of the guest identified by the Guest-Token header.",
                "operationId": "fb37863e7a6344362e796de5deee696e",
                "parameters": [
                    {
                        "name": "itemId",
                        "in": "path",
                        "description": "Cart item ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "quantity"
                                ],
                                "properties": {
                                    "quantity": {
                                        "description": "New quantity",
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Cart updated successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    },
                    "404": {
                        "description": "Cart item not found"
                    },
                    "422": {
                        "description": "Validation error or not enough stock"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Cart"
                ],
                "summary": "Remove Cart Item",
                "description": "Remove a single item from the cart of the authenticated user, or of the guest identified by the Guest-Token header.",
                "operationId": "b73fed7e79f1ebea0e19417a04bc670d",
                "parameters": [
                    {
                        "name": "itemId",
                        "in": "path",
                        "description": "Cart item ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product removed from cart successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    },
                    "404": {
                        "description": "Cart item not found"
                    }
                }
            }
        },
        "/api/contact-us": {
            "post": {
                "tags": [
                    "Contact us"
                ],
                "summary": "Send Contact Message",
                "description": "Store a message sent from the contact form. Open to guests and signed-in customers alike; the message then shows up in the admin panel.",
                "operationId": "f481bdd67a55c7284f031bc50f598646",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phone",
                                    "message"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Sender name",
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "phone": {
                                        "description": "Sender phone number",
                                        "type": "string",
                                        "maxLength": 20
                                    },
                                    "email": {
                                        "description": "Sender email, optional",
                                        "type": "string",
                                        "format": "email",
                                        "nullable": true
                                    },
                                    "message": {
                                        "description": "Message body",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Your message has been sent successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/favorites": {
            "get": {
                "tags": [
                    "Favorites"
                ],
                "summary": "Get Favorites",
                "description": "Retrieve the favorites list of the authenticated user, or of a guest identified by the Guest-Token header.",
                "operationId": "d5e65990bf956837beb87a8bc8da2d43",
                "parameters": [
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Favorites retrieved successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    }
                }
            },
            "post": {
                "tags": [
                    "Favorites"
                ],
                "summary": "Add To Favorites",
                "description": "Add a product to the favorites list of the authenticated user, or of a guest identified by the Guest-Token header. Adding the same product twice does not duplicate it.",
                "operationId": "f18a5a30f5dc74ffeb4007679af878d8",
                "parameters": [
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "product_id"
                                ],
                                "properties": {
                                    "product_id": {
                                        "description": "Product ID",
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Product added to favorites successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/favorites/{productId}": {
            "delete": {
                "tags": [
                    "Favorites"
                ],
                "summary": "Remove From Favorites",
                "description": "Remove a product from the favorites list of the authenticated user, or of a guest identified by the Guest-Token header.",
                "operationId": "c81c67af5a62622480761026b566d15e",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "Guest-Token",
                        "in": "header",
                        "description": "Guest identifier, required when the request is not authenticated",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product removed from favorites successfully"
                    },
                    "400": {
                        "description": "Guest token is required"
                    }
                }
            }
        },
        "/api/guest-token": {
            "post": {
                "tags": [
                    "Guest"
                ],
                "summary": "Generate Guest Token",
                "description": "Generate a unique guest identifier. The client stores it and sends it back in the Guest-Token header on the favorites and cart endpoints so a visitor keeps their data before signing up.",
                "operationId": "fca7327fdf8f12bdd3b2a7165cdb4563",
                "responses": {
                    "200": {
                        "description": "Guest token generated successfully"
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get All Products",
                "description": "Retrieve all products with their categories and images",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "responses": {
                    "200": {
                        "description": "Products retrieved successfully"
                    }
                }
            }
        },
        "/api/products/{id}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get Product Details",
                "description": "Retrieve a specific product with its category and images",
                "operationId": "c87fb2e4d617e7b36c712cad358acdb8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product retrieved successfully"
                    },
                    "404": {
                        "description": "Product not found"
                    }
                }
            }
        }
    },
